{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["chrome", "vite/client"],
    "lib": ["ES2022", "DOM", "WebWorker"]
  },
  "include": ["src", "tests", "manifest.config.ts", "vite.config.ts"]
}
